kubectl get nodes
kubectl get pods
kubectl get pods -A

kubectl create deployment --image nginx web
kubectl describe deployment web

# expoe localmente
kubectl expose deployment web --port=80 --target-port=80 --type=NodePort

kubectl get svc

kubectl delete svc web

# situacao quando tiver IP publico
kubectl expose deployment web --type=LoadBalancer 

# listar containers num pod
kubectl get pod -o="custom-columns=NAME:.metadata.name,INIT-CONTAINERS:.spec.initContainers[*].name,CONTAINERS:.spec.containers[*].name"

